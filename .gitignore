# =========================
# .NET / ASP.NET Core (backend/)
# =========================
bin/
obj/
out/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Secrets - fill in appsettings.Development.json locally, never commit it
backend/**/appsettings.Development.json
backend/**/appsettings.*.local.json
**/secrets.json

# =========================
# Node / Expo / React Native (mobile/)
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo
.expo/
.expo-shared/
dist/
web-build/

# Native build artifacts (if ever ejected / prebuilt)
mobile/ios/
mobile/android/

# Env files - use .env.example as the template, never commit real values
.env
.env.local
.env.*.local
!.env.example

# =========================
# Editor / OS
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
